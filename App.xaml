<Application x:Class="SvchostMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Global Dark Theme Colors -->
            <Color x:Key="BackgroundColor">#FF0D0D0F</Color>
            <Color x:Key="SurfaceColor">#FF16161A</Color>
            <Color x:Key="BorderColor">#FF2A2A35</Color>
            <Color x:Key="AccentColor">#FF00D4FF</Color>
            <Color x:Key="DangerColor">#FFFF4455</Color>
            <Color x:Key="SuccessColor">#FF00E676</Color>
            <Color x:Key="TextPrimaryColor">#FFF0F0F5</Color>
            <Color x:Key="TextSecondaryColor">#FF8888A0</Color>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

            <!-- Tray Icon Context Menu -->
            <ContextMenu x:Key="TrayContextMenu">
                <MenuItem Header="Open" Click="TrayMenuOpen_Click"/>
                <Separator/>
                <MenuItem Header="Pause Enforcement" Click="TrayMenuPause_Click"/>
                <Separator/>
                <MenuItem Header="Exit Completely" Click="TrayMenuExit_Click"/>
            </ContextMenu>

            <!-- Tray Icon -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                            ToolTipText="Svchost Network Monitor"
                            ContextMenu="{StaticResource TrayContextMenu}"
                            TrayMouseDoubleClick="TrayIcon_DoubleClick"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
